# LLM provider: ollama (default) | openai (any OpenAI-compatible API)
LLM_PROVIDER=
# Ollama Cloud (https://ollama.com/settings/keys)
OLLAMA_API_KEY=
OLLAMA_MODEL=deepseek-v4.1-flash
# Optional. Defaults to https://ollama.com
OLLAMA_BASE_URL=
# LLM_PROVIDER=openai. OPENAI_BASE_URL is optional (defaults to https://api.openai.com/v1);
# e.g. Groq free tier: OPENAI_BASE_URL=https://api.groq.com/openai/v1, OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
# Group system → K Electronics A2A surface. Defaults to http://localhost:8000/api/a2a/run
K_ELECTRONICS_A2A_URL=
# Meeting store (meeting Tools): Postgres 15+; each system creates and seeds its own schema (kelec / grp) on first use.
# e.g. docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=dev postgres:17 → postgresql://postgres:dev@localhost:5432/postgres
MEETINGS_DATABASE_URL=
# Clearance of requests without a principal (local UIs, tests): 0 none … 4 극비. Deployments behind the gateway use 0.
MEETINGS_ANONYMOUS_CLEARANCE=4
# Tests only: a disposable database whose name contains "test" (its kelec / grp schemas are dropped per test)
MEETINGS_TEST_DATABASE_URL=
# Who may finalize / correct minutes, review Compliance flags, approve mail, accept task requests (besides the meeting's
# chair / secretary). Comma-separated Keycloak groups; "*" = everyone (local demo without a principal).
MEETINGS_CONFIRM_GROUPS=*
# The principal signed by the gateway (HS256, shared secret). Set → only signed principals are trusted.
PRINCIPAL_SIGNING_KEY=
# Recording transcripts: speech-service base URL + its API key; copied transcripts expire after this many days.
SPEECH_SERVICE_URL=
SPEECH_API_KEY=
MEETINGS_TRANSCRIPT_RETENTION_DAYS=365
# Mail recipients' registered emails: the gateway's internal directory API.
DIRECTORY_URL=
INTERNAL_API_KEY=
# Background jobs (send approved mail every minute, reminders / address retry / transcript purge daily). Off unless 1.
MEETINGS_BACKGROUND_JOBS=0
MEETINGS_DAILY_HOUR=9
# SMTP for approved mail (empty host → approved mail waits). SMTP_SECURITY: starttls | ssl | none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
