# LLM provider: ollama (default) | openai (any OpenAI-compatible API)
LLM_PROVIDER=
# Ollama Cloud (https://ollama.com/settings/keys)
OLLAMA_API_KEY=
OLLAMA_MODEL=deepseek-v4.1-flash
# 팀 테스트 후보: gpt-oss:20b-cloud, gemma4:31b-cloud (비교: python briefing_demo.py "HBM 시장" --compare gpt-oss:20b-cloud,gemma4:31b-cloud)
# Optional. Defaults to https://ollama.com
OLLAMA_BASE_URL=
# LLM_PROVIDER=openai. OPENAI_BASE_URL is optional (defaults to https://api.openai.com/v1);
# e.g. Groq free tier: OPENAI_BASE_URL=https://api.groq.com/openai/v1, OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
# Group system → K Electronics A2A surface. Defaults to http://localhost:8000/api/a2a/run
K_ELECTRONICS_A2A_URL=
# Meeting store (meeting Tools): Postgres 15+; each system creates and seeds its own schema (kelec / grp) on first use.
# e.g. docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=dev postgres:17 → postgresql://postgres:dev@localhost:5432/postgres
MEETINGS_DATABASE_URL=
# Clearance of requests without a principal (local UIs, tests): 0 none … 4 극비. Deployments behind the gateway use 0.
MEETINGS_ANONYMOUS_CLEARANCE=4
# Tests only: a disposable database whose name contains "test" (its kelec / grp schemas are dropped per test)
MEETINGS_TEST_DATABASE_URL=
# Optional: news_collection CLI uses the Naver News search API when both are set (https://developers.naver.com), Google News RSS otherwise
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# News delivery (news_delivery CLI, run_personal_news_briefing). Telegram: create a bot with @BotFather, send it a message,
# then https://api.telegram.org/bot<TOKEN>/getUpdates shows your chat id
NEWS_TELEGRAM_BOT_TOKEN=
NEWS_TELEGRAM_CHAT_ID=
# E-mail: Gmail needs an app password (Google account → Security → 2-Step Verification → App passwords). Host defaults to smtp.gmail.com:465
NEWS_SMTP_HOST=
NEWS_SMTP_PORT=
NEWS_SMTP_USER=
NEWS_SMTP_PASSWORD=
NEWS_EMAIL_TO=
